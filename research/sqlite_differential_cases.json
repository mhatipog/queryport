{
  "schema_version": 1,
  "description": "Deterministic, published semantics-based executable SQLite comparison of the pinned original SQLGlot baseline and QueryPort. Not a comprehensive cross-engine certification.",
  "readme": "Dialect source semantics from official PostgreSQL, DuckDB, Microsoft, Oracle, MySQL, Spark and BigQuery docs; expected results computed independently for each case.",
  "cases": [
    {
      "id": "year_boundary",
      "read": "tsql",
      "sql": "SELECT DATEDIFF(year, '2023-12-31', '2024-01-01')",
      "expected": 1,
      "comparison": "integer",
      "api": "sqlglot_transpile"
    },
    {
      "id": "year_reverse",
      "read": "tsql",
      "sql": "SELECT DATEDIFF(year, '2024-01-01', '2023-12-31')",
      "expected": -1,
      "comparison": "integer",
      "api": "sqlglot_transpile"
    },
    {
      "id": "year_same",
      "read": "tsql",
      "sql": "SELECT DATEDIFF(year, '2024-02-01', '2024-12-31')",
      "expected": 0,
      "comparison": "integer",
      "api": "sqlglot_transpile"
    },
    {
